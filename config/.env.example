# Splitwise API Credentials
# Get these from https://secure.splitwise.com/apps
SPLITWISE_CONSUMER_KEY=your_consumer_key_here
SPLITWISE_CONSUMER_SECRET=your_consumer_secret_here
SPLITWISE_API_KEY=your_api_key_here

# Splitwise User IDs (Get these from your Splitwise profile or API)
# Required for categorization and splitting logic
SPLITWISE_SELF_ID=your_self_user_id_here
SPLITWISE_PARTNER_ID=your_partner_user_id_here

# Google Sheets Configuration
# The ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_KEY/edit
SPREADSHEET_KEY=your_google_sheets_key_here

# Date range and Worksheet settings (update for current year)
START_DATE=2026-01-01
END_DATE=2026-12-31
EXPENSES_WORKSHEET_NAME=Expense Log

# Spending dashboard: optional per-category monthly budget targets, as a
# JSON object (category name -> $ amount). Powers the dashboard's
# "Budget vs. Actual" section; omit to leave it hidden.
CATEGORY_BUDGETS={"Food and drink": 700, "Travel": 300}
